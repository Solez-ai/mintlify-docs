              "firmware/serial-protocol",
              "firmware/shift-modifier",
              "firmware/language-switching"
            ]
          },
          {
            "group": "Desktop App (PyQt6)",
            "pages": [
              "desktop/overview",
              "desktop/multi-device-ble",
              "desktop/teacher-and-logs"
            ]
          },
          {
            "group": "Android App",
            "pages": [
              "android/overview",
              "android/ble-service"
            ]
          },
